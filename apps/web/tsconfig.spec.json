/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "target": "es2022",
    "types": ["node", "vitest/globals"]
  },
  "files": ["src/test-setup.ts"],
  // The pages are reached through the router's glob (a dynamic import), so no spec imports them statically;
  // listing them keeps them in the compiler's program, so the Angular plugin compiles them like the build does.
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts", "src/app/**/*.ts", "src/server/**/*.ts", "src/shared/**/*.ts", "src/build/**/*.ts", "scripts/**/*.ts"]
}

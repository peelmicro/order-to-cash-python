{
  "name": "web",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "dev": "node --env-file-if-exists=../../.env scripts/serve.mjs dev",
    "start": "node --env-file-if-exists=../../.env scripts/serve.mjs preview",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest",
    "preview": "node --env-file-if-exists=../../.env scripts/serve.mjs preview",
    "test:ci": "vitest run",
    "types:generate": "node scripts/openapi-types.mjs generate",
    "types:check": "node scripts/openapi-types.mjs check",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json"
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "^2.8.0",
    "@analogjs/router": "^2.8.0",
    "@angular/cdk": "22.2.1",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@spartan-ng/brain": "1.7.0",
    "@tanstack/angular-query-experimental": "5.104.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "front-matter": "^4.0.2",
    "h3": "1.15.11",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "3.7.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.8.0",
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@analogjs/vitest-angular": "^2.8.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@spartan-ng/cli": "1.7.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@types/node": "24.13.5",
    "eventsource": "5.1.1",
    "jsdom": "^30.0.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  },
  "packageManager": "pnpm@12.8.1"
}

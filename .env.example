# Order-To-Cash (Python) — environment template.
#
# Copy to `.env` and adjust. Every value here is a DEV DEFAULT: no account, no
# API key and no cloud service is needed anywhere in this stack.
#
# This file grows one phase at a time, like the README — it documents what
# exists, never what is planned. Phase 4 covers the infrastructure; the
# application variables arrive with the services that read them.

# ── General ───────────────────────────────────────────────────────────────
TZ=Europe/Madrid

# Docker Compose project namespace. #7 (order-to-cash-nestjs) uses `otc` and
# #8 (order-to-cash-dotnet) uses `otcnet`; sharing either would make this stack
# silently adopt the other's volumes — its Grafana database, MongoDB read model
# and Kafka log directory — corrupting the comparison the trilogy exists to
# make. The LOGICAL database names below stay `otc_*`: shared-spec parity.
# Host ports are #8's, so only one trilogy stack runs at a time.
COMPOSE_PROJECT_NAME=otcpy

# ── PostgreSQL (orders, fulfillment, billing, notifications — and n8n) ────
# One instance, four logical databases: database-per-service, no cross-database
# join, no foreign key across a service boundary. Created, with the two login
# roles below, by infra/postgres/init/01-create-databases.sh on first init.
POSTGRES_HOST_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=otc_pg_dev_password

# The application role. It OWNS the four otc_* databases — since PostgreSQL 15
# only the owner may create objects in `public`, and Alembic creates, alters and
# drops them. A migration/runtime role split is a production concern, and the
# README says so rather than this file pretending to it.
POSTGRES_APP_USER=otc_app
POSTGRES_APP_PASSWORD=otc_app_dev_password

# Read by the init script and by the healthcheck (which counts them), so these
# names have exactly one source of truth.
POSTGRES_DB_ORDERS=otc_orders
POSTGRES_DB_FULFILLMENT=otc_fulfillment
POSTGRES_DB_BILLING=otc_billing
POSTGRES_DB_NOTIFICATIONS=otc_notifications

# n8n's own role and database. CONNECT is revoked from PUBLIC everywhere, so
# this role cannot open an otc_* database at all: n8n's tables can only ever
# land in its own database.
POSTGRES_N8N_USER=otc_n8n
POSTGRES_N8N_PASSWORD=otc_n8n_db_dev_password
POSTGRES_DB_N8N=n8n

# ── MongoDB (read model — otc_read_model.order_timeline) ──────────────────
MONGO_HOST_PORT=27017
MONGO_INITDB_ROOT_USERNAME=otc_mongo_root
MONGO_INITDB_ROOT_PASSWORD=otc_mongo_dev_password
MONGO_DB_READMODEL=otc_read_model

# ── Kafka (fact stream, KRaft single-node — no ZooKeeper) ─────────────────
# Two listeners: containers reach the broker at kafka:29092, the host reaches
# it at localhost:9092. Using the wrong one is the classic Kafka-in-Docker
# failure — a client connects, gets told to talk to `kafka`, and cannot
# resolve it.
KAFKA_HOST_PORT=9092
KAFKA_INTERNAL_HOST=kafka
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=9093
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Partition count is above 1 to allow future consumer-group parallelism, and is
# safe for the saga's ordering guarantee: every producer keys these topics by
# `correlationId` (the order id), so all facts about one order hash to the same
# partition and are read in emission order. Replication is 1 — one broker.
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION_FACTOR=1

# ── Orders outbox relay and fact producer (feature 14) ────────────────────
# Where the producer connects from the HOST (the broker's EXTERNAL listener).
KAFKA_BROKERS=localhost:9092
# The producer's client id; fulfillment and billing will use distinct ids.
KAFKA_CLIENT_ID=otc-orders
# false disables the relay task (one relay per write model in a scaled-out deployment).
OUTBOX_RELAY_ENABLED=true
# Milliseconds between poll cycles (the next cycle never starts while one is running).
OUTBOX_POLL_INTERVAL_MS=250
# Most records one claim takes; bounds how long the claim transaction stays open.
OUTBOX_BATCH_SIZE=100
# Milliseconds a batch may wait for the broker's acknowledgement before the claim is rolled back.
OUTBOX_PUBLISH_TIMEOUT_MS=5000

# ── Redpanda Console (Kafka UI) + kafka-exporter (consumer lag) ───────────
REDPANDA_CONSOLE_HOST_PORT=8080
KAFKA_EXPORTER_HOST_PORT=9308

# ── NATS (RPC transport — core only, JetStream deliberately OFF) ──────────
# Durability is Kafka's job. Nothing on the RPC path needs replay: a timeout is
# a legitimate, handled answer. See specs/shared/asyncapi.yaml.
NATS_CLIENT_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222
# NATS server URL for the Orders service (`orders.create` responder, `fulfillment.stock.check`
# client), from OUTSIDE a container. Read by services/orders `NatsSettings`.
NATS_URL=nats://localhost:4222
# How long `orders.create` waits for `fulfillment.stock.check` before it answers TIMEOUT (a silent
# responder) — a missing responder is answered UNAVAILABLE at once, without waiting.
STOCK_CHECK_TIMEOUT_MS=5000
# Worker processes of the Orders server (uvicorn reads this for `--workers`). The service REFUSES
# to boot with more than one while OUTBOX_RELAY_ENABLED=true: two relays can publish one order's
# facts out of order. Leave at 1, or disable the relay on every replica but one.
WEB_CONCURRENCY=1

# ── Orders saga orchestrator (read by services/orders `SagaSettings`) ──────
# Per-attempt budget for a saga command over NATS (`stock.reserve`, `credit.hold`, ...).
SAGA_COMMAND_TIMEOUT_MS=5000
# In-line attempts before a command is parked (1..10); parked rows are retried by the sweeper.
SAGA_COMMAND_MAX_ATTEMPTS=3
# Pause after the first failed attempt, doubling per attempt (500 ms, then 1 000 ms).
SAGA_COMMAND_BACKOFF_MS=500
# How long a claimed row is invisible to every other claimer; must be at least twice the worst-case
# dispatch (3 x 5 000 + 1 500 = 16 500 ms), or the service refuses to start.
SAGA_COMMAND_LEASE_MS=60000
# Ceiling of the park back-off (30 s x 2 per exhausted cycle: 60 s, 120 s, ... capped here).
SAGA_PARK_RETRY_CAP_MS=900000
# The durable backstop that issues owed commands the fast path did not, and re-attempts parked ones.
SAGA_SWEEPER_ENABLED=true
# Milliseconds between sweeper cycles (a cycle never starts while one is running).
SAGA_SWEEPER_INTERVAL_MS=30000
# A pending row younger than this is left to the fast path; also the worst-case latency of a command
# the fast path dropped (this + the sweeper interval).
SAGA_PENDING_GRACE_MS=10000
# Most rows one sweep claims; they are dispatched concurrently.
SAGA_SWEEPER_BATCH_LIMIT=20
# Most fast-path dispatches in flight (at least 1); a signal beyond it is left to the sweeper.
SAGA_FAST_PATH_MAX_IN_FLIGHT=256
# false: this process consumes no facts (the fast path and the sweeper still issue owed commands).
SAGA_CONSUMER_ENABLED=true

# ── Mailpit (self-hosted SMTP sink + web inbox) ───────────────────────────
# Notification emails are really sent over SMTP and really land in an inbox you
# can open — against a local sink with no account, no quota and no password to
# leak. #7's lesson, inherited: a cloud sandbox rate-limited a topic replay and
# silently dead-lettered facts.
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
MAILPIT_MAX_MESSAGES=500

# ── Observability: OTel Collector → Jaeger, Prometheus, Grafana ───────────
OTEL_COLLECTOR_GRPC_HOST_PORT=4317
OTEL_COLLECTOR_HTTP_HOST_PORT=4318
JAEGER_UI_HOST_PORT=16686
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=otc_grafana_dev_password

# ── n8n (demo workflows, REST-only against the Gateway) ───────────────────
# Behind the `n8n` compose profile. The four workflow JSONs are reused
# unchanged from #8 and #7 — they speak only the Gateway's OpenAPI contract,
# which is why the base URL is the sole difference. Storage is PostgreSQL, in
# the `n8n` database above (#7 and #8 both ended on SQLite).
N8N_HOST_PORT=5678
N8N_ENCRYPTION_KEY=otc_n8n_dev_encryption_key_change_me
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=otc_n8n_dev_password
N8N_WORKFLOWS_ENABLED=true

# The Gateway does not exist until Phase 13; these are the values the workflows
# will use when it does, declared here because the n8n container reads them at
# start and an unset variable is harder to debug than a documented one.
# OTC_GATEWAY_URL is left unset: compose derives http://gateway:${GATEWAY_PORT}.
# While the Gateway runs as a host process, override it with
# OTC_GATEWAY_URL=http://host.docker.internal:3001.
GATEWAY_PORT=3001
GATEWAY_OPERATOR_USERNAME=operator
GATEWAY_OPERATOR_PASSWORD=otc_operator_dev_password_change_me
OTC_REQUEST_TIMEOUT_MS=10000
# OTC_GATEWAY_URL=http://host.docker.internal:3001

ORDER_GENERATOR_ENABLED=true
ORDER_GENERATOR_INTERVAL_SECONDS=45
ORDER_GENERATOR_ORDERS_PER_RUN=1
ORDER_GENERATOR_COMPENSATION_RATIO=0.15
ORDER_GENERATOR_MAX_LINES=4
ORDER_GENERATOR_MAX_UNITS=10
ORDER_GENERATOR_RETAILERS=
ORDER_GENERATOR_COMPANIES=
ORDER_GENERATOR_CATALOG_TTL_SECONDS=600

PAYMENT_ROBOT_ENABLED=true
PAYMENT_ROBOT_INTERVAL_SECONDS=120
PAYMENT_AGE_MINUTES=2
PAYMENT_ROBOT_BATCH_SIZE=10
PAYMENT_ROBOT_RETAILERS=

STOCK_REPLENISH_ENABLED=true
STOCK_REPLENISH_INTERVAL_SECONDS=300
STOCK_REPLENISH_TOP_UP_UNITS=100
STOCK_REPLENISH_BATCH_SIZE=50
STOCK_REPLENISH_COMPANIES=

BURST_ENABLED=true
BURST_ORDER_COUNT=20
BURST_CONCURRENCY=5
BURST_COMPENSATION_RATIO=0.20
BURST_WEBHOOK_PATH=otc-burst

# ── SonarQube (opt-in, compose profile "sonar", ~1.5 GB RAM) ──────────────
# Coverage gates are enforced by ./quality.sh regardless, so code quality never
# depends on this container running.
SONARQUBE_HOST_PORT=9000
